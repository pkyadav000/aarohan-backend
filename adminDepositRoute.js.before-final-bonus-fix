const mongoose = require("mongoose");
const Deposit = require("./models/Deposit");
const User = require("./models/User");

const {
    isAllowedPackage,
    getDailyROI,
    getMaxCap,
    DIRECT_BONUS_RATE
} = require("./packageConfig");

async function approveDeposit(req, res) {
    const session = await mongoose.startSession();

    try {
        const { depositId } = req.params;

        if (!depositId) {
            return res.status(400).json({
                success: false,
                message: "Deposit ID is required."
            });
        }

        session.startTransaction();

        const deposit = await Deposit.findOne({
            depositId
        }).session(session);

        if (!deposit) {
            await session.abortTransaction();

            return res.status(404).json({
                success: false,
                message: "Deposit not found."
            });
        }

        if (deposit.status !== "PENDING") {
            await session.abortTransaction();

            return res.status(409).json({
                success: false,
                message:
                    `Deposit is already ${deposit.status.toLowerCase()}.`
            });
        }

        const amount = Number(deposit.amount);

        if (!isAllowedPackage(amount)) {
            await session.abortTransaction();

            return res.status(400).json({
                success: false,
                message:
                    "Invalid package amount. Allowed packages are ₹999, ₹1,999, ₹4,999 and ₹9,999."
            });
        }

        const user = await User.findOne({
            userId: deposit.userId
        }).session(session);

        if (!user) {
            await session.abortTransaction();

            return res.status(404).json({
                success: false,
                message: "User not found."
            });
        }

        if (user.status === "SUSPENDED") {
            await session.abortTransaction();

            return res.status(403).json({
                success: false,
                message: "User account is suspended."
            });
        }

        if (!Array.isArray(user.packages)) {
            user.packages = [];
        }

        const approvalDate = new Date()
            .toISOString()
            .slice(0, 10);

        const packageId =
            "PKG" +
            Date.now() +
            Math.random()
                .toString(36)
                .slice(2, 8)
                .toUpperCase();

        const dailyROI =
            getDailyROI(amount);

        const maxCap =
            getMaxCap(amount);

        user.packages.push({
            id: packageId,
            amount: amount,
            status: "ACTIVE",
            dailyROI: dailyROI,
            totalEarned: 0,
            maxCap: maxCap,
            approvalDate: approvalDate,
            lastRoiDate: null
        });

        user.package =
            user.packages
                .filter(pkg =>
                    pkg &&
                    pkg.status === "ACTIVE"
                )
                .reduce(
                    (total, pkg) =>
                        total +
                        Number(pkg.amount || 0),
                    0
                );

        user.roiDaily =
            user.packages
                .filter(pkg =>
                    pkg &&
                    pkg.status === "ACTIVE"
                )
                .reduce(
                    (total, pkg) =>
                        total +
                        Number(pkg.dailyROI || 0),
                    0
                );

        user.status = "ACTIVE";

        const sponsorId =
            String(user.sponsorId || "")
                .trim()
                .toUpperCase();

        let directBonus = 0;
        let bonusSponsor = null;

        if (
            sponsorId &&
            sponsorId !== "AG1001"
        ) {
            bonusSponsor =
                await User.findOne({
                    userId: sponsorId
                }).session(session);

            if (bonusSponsor) {
                directBonus =
                    amount * DIRECT_BONUS_RATE;

                bonusSponsor.walletBal =
                    Number(
                        bonusSponsor.walletBal || 0
                    ) + directBonus;

                bonusSponsor.totalEarned =
                    Number(
                        bonusSponsor.totalEarned || 0
                    ) + directBonus;

                bonusSponsor.teamEarned =
                    Number(
                        bonusSponsor.teamEarned || 0
                    ) + directBonus;

                if (
                    !Array.isArray(
                        bonusSponsor.commissionHistory
                    )
                ) {
                    bonusSponsor.commissionHistory = [];
                }

                bonusSponsor.commissionHistory.push({
                    id:
                        "COM_" +
                        Date.now() +
                        "_" +
                        user.userId,

                    type:
                        "DIRECT_BONUS",

                    level: 1,

                    fromUser:
                        user.userId,

                    packageAmount:
                        amount,

                    amount:
                        directBonus,

                    date:
                        approvalDate
                });

                await bonusSponsor.save({
                    session
                });
            }
        }

        const updatedDeposit =
            await Deposit.findOneAndUpdate(
                {
                    _id: deposit._id,
                    status: "PENDING"
                },
                {
                    $set: {
                        status: "APPROVED",
                        approvedBy:
                            req.auth.userId,
                        approvedAt:
                            new Date()
                    }
                },
                {
                    new: true,
                    session
                }
            );

        if (!updatedDeposit) {
            await session.abortTransaction();

            return res.status(409).json({
                success: false,
                message:
                    "Deposit was already processed."
            });
        }

        await user.save({
            session
        });

        await session.commitTransaction();

        return res.json({
            success: true,

            message:
                "Deposit approved and package activated.",

            deposit: {
                depositId:
                    updatedDeposit.depositId,

                status:
                    updatedDeposit.status,

                amount:
                    updatedDeposit.amount,

                approvedBy:
                    updatedDeposit.approvedBy,

                approvedAt:
                    updatedDeposit.approvedAt
            },

            package: {
                id:
                    packageId,

                amount:
                    amount,

                status:
                    "ACTIVE",

                dailyROI:
                    dailyROI,

                maxCap:
                    maxCap,

                approvalDate:
                    approvalDate,

                roiStarts:
                    "NEXT_DAY"
            },

            directBonus: {
                sponsorId:
                    sponsorId || null,

                amount:
                    directBonus
            },

            walletBalance:
                user.walletBal
        });

    } catch (error) {

        try {
            await session.abortTransaction();
        } catch (_) {}

        console.error(
            "APPROVE DEPOSIT ERROR:",
            error
        );

        return res.status(500).json({
            success: false,
            message:
                "Deposit approval failed."
        });

    } finally {
        await session.endSession();
    }
}

module.exports = approveDeposit;
